.textbox {
    background-color: rgb(154, 109, 56);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-left-color: rgb(85, 69, 44);
    border-right-color: rgb(166, 146, 65);
    border-top-color: rgb(166, 146, 65);
    border-bottom-color: rgb(85, 69, 44);
    font-size: 16px;
}

#unity-checkmark {
    background-color: rgb(146, 101, 52);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(52, 36, 24);
    border-right-color: rgb(52, 36, 24);
    border-top-color: rgb(52, 36, 24);
    border-bottom-color: rgb(52, 36, 24);
}

#unity-text-input {
    background-color: rgb(146, 101, 52);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(52, 36, 24);
    border-right-color: rgb(52, 36, 24);
    border-top-color: rgb(52, 36, 24);
    border-bottom-color: rgb(52, 36, 24);
    font-size: 16px;
}

.folder-button {
    background-color: rgba(188, 188, 188, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    align-self: center;
}

.text-field-container {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 8px;
}

.text-field-container > TextField {
    flex: 1 1 auto;
    min-width: 0;
    -unity-text-overflow-position: end;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 8px;
}

.text-field-container > Button {
    flex: 0 0 auto;
    background-color: transparent;
    padding: 0;
    width: 24px;
    height: 24px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
