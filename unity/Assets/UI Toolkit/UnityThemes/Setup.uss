/* The setup wizard (TASK-1014). Units are the MetaPanelSettings reference (1200x540, height-matched):
   on a 2400x1080 phone of ~420 dpi one unit is 2 px = 0.76 dp, so 48dp = 63 units and 16sp = 21 units.
   No game data exists yet on this screen: Alegreya and the port's own textures only. */
:root {
    -unity-font-definition: url("project://database/Assets/BuiltIn/Fonts/Alegreya/Alegreya-Medium.ttf");
    color: #2b1d10;
    font-size: 22px;
}

.setup-table {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding: 12px 16px;
    background-image: url("project://database/Assets/BuiltIn/BookSpread/table.jpg");
    -unity-background-scale-mode: scale-and-crop;
}

.setup-card {
    width: 100%;
    max-width: 760px; /* wide enough that a small phone (840x472 units) shows the Android Find step unscrolled */
    max-height: 100%;
    border-radius: 6px;
    background-image: url("project://database/Assets/BuiltIn/Enhanced/Stone/parchment.jpg");
    -unity-background-scale-mode: scale-and-crop;
}

/* parchment.jpg is a mid brown (median #936736, darkest 24px block #916234): ink on it alone is 3.1:1. The cream
   wash is the least that keeps every text colour at 4.5:1 over the darkest block. The panel blends in linear
   colour, so 0.35 gives #bda38a there: dim #4a3826 4.65:1, link #6d1c14 4.8:1, ink 6.8:1 (measured on the render). */
.setup-sheet {
    flex-shrink: 1;
    padding: 12px 28px 12px 28px;
    border-radius: 6px;
    background-color: rgba(246, 234, 212, 0.35);
}

.setup-top {
    flex-direction: row;
    flex-shrink: 0; /* only the body gives way: a squeezed row let the Back link overlap the scrolled text */
}

.setup-top-rule {
    border-bottom-width: 1px;
    border-color: rgba(43, 29, 16, 0.3);
    margin-bottom: 4px;
}

.setup-step {
    flex-shrink: 0;
    font-size: 21px;
    letter-spacing: 2px;
    color: #4a3826;
    margin: 0;
    padding: 0;
}

.setup-body {
    flex-shrink: 1;
    flex-grow: 0;
}

.setup-title {
    font-size: 34px;
    margin: 2px 0 6px 0;
    padding: 0;
    white-space: normal;
}

.setup-text {
    white-space: normal;
    margin: 0 0 8px 0;
    padding: 0;
}

.setup-help-head {
    -unity-font-style: bold;
    margin-bottom: 0;
}

.setup-dim {
    color: #4a3826;
}

.setup-note {
    white-space: normal;
    margin: 4px 0 8px 0;
    padding: 8px 12px;
    border-width: 2px;
    border-color: #9b1c12;
    border-radius: 4px;
    background-color: #f6ead4;
    color: #6a0f08;
}

.setup-row {
    flex-direction: row;
    align-items: center;
    height: 34px;
}

.setup-mark {
    width: 22px;
    height: 22px;
    margin-right: 12px;
}

.setup-buttons {
    flex-shrink: 0;
    flex-direction: row;
    padding-top: 8px;
}

.setup-buttons > Button {
    flex-grow: 1;
    flex-basis: 0; /* side by side, the two are as wide as each other */
}

.setup-links {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.setup-links-stacked {
    flex-direction: column;
    align-items: center;
}

Button {
    min-height: 64px;
    margin: 0 4px;
    padding: 0 16px;
    font-size: 24px;
    border-radius: 6px;
    white-space: normal;
}

.setup-primary {
    background-color: #8e2a1f;
    border-width: 2px;
    border-color: #6d1c14;
    border-bottom-width: 4px;
    color: #fbf3e2;
}

.setup-primary:hover {
    background-color: #9e3426;
}

.setup-primary:active {
    background-color: #6d1c14;
}

.setup-primary:disabled {
    opacity: 0.5;
}

.setup-outline {
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: #6d1c14;
    color: #6d1c14;
}

.setup-outline:hover {
    background-color: rgba(109, 28, 20, 0.08);
}

.setup-link {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0 10px;
    font-size: 22px;
    color: #6d1c14;
}

.setup-link:hover {
    color: #8e2a1f;
}

.setup-ok {
    color: #265a22; /* 3.4:1 over the darkest washed parchment: a mark needs 3:1 */
}

.setup-bad {
    color: #9b1c12;
}

/* The help card scrolls by drag; its bar is a thin ink line, not the default grey arrows. */
.setup-body .unity-scroller__low-button,
.setup-body .unity-scroller__high-button {
    display: none;
}

.setup-body .unity-scroller--vertical {
    width: 10px;
}

.setup-body .unity-base-slider__tracker {
    background-color: rgba(43, 29, 16, 0.1);
    border-width: 0;
}

.setup-body .unity-base-slider__dragger {
    background-color: rgba(43, 29, 16, 0.45);
    border-width: 0;
    border-radius: 4px;
}
