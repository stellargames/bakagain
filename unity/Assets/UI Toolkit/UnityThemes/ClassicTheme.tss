/* Colour tokens — the single source of all UI RGB. Defined on the universal selector so
   they resolve for EVERY element in the shared panel (REQ screens AND DialogManager dialogs,
   which share .text-button but live in separate UIDocument roots) — no per-root theme class
   needed. Per-screen variation is done with the .colorset-* classes below; a future enhanced
   theme swaps this whole stylesheet. */
* {
    --ui-ink: rgb(0, 0, 0);
    --ui-shadow: rgb(85, 69, 44);
    --ui-slate: rgb(48, 56, 56);
    --ui-edge: rgb(166, 146, 65);
    --ui-parchment: rgb(219, 199, 121);
    --ui-surface: rgb(154, 109, 56);
}

/* .text-button is shared: REQ buttons (absolutely placed by data, add .req-element)
   AND flex-laid-out dialog buttons (DialogManager) — so no position here. */
.text-button {
    margin: 0;
    padding: 0;
    background-color: var(--ui-surface);
    border-top-color: var(--ui-edge);
    border-left-color: var(--ui-shadow);
    border-right-color: var(--ui-edge);
    border-bottom-color: var(--ui-shadow);
    color: var(--ui-parchment);
    text-shadow: 0 6px 0 var(--ui-shadow);
    border-bottom-width: 6px;
    border-top-width: 6px;
    border-left-width: 5px;
    border-right-width: 5px;
    -unity-text-align: middle-center;
    font-size: 55px;
    white-space: nowrap;
    /* The caption is a CHILD (GameFontText.Caption), inert to the pointer, which is why this
       element centres its content rather than its own text. The font-size and text-align above stay: colour, font and shadow are inherited
       properties in UI Toolkit, so .keyword-asked's recolouring still reaches the caption. */
    align-items: center;
    justify-content: center;
}

/* An already-asked keyword topic. NOT a dimmed button: the original builds it as widget type 8,
   which shares widget_draw_text_button with type 6 and differs only in the UNPRESSED branch —
   textColor 0x0a -> 1 and the drop shadow dropped (WIDGET.C:373-376). Same chrome, same fill, same
   edges. Pressed ignores the type entirely, which is why an asked topic still presses normally and
   stays clickable. --ui-parchment is pen 0x0a and --ui-shadow pen 1, as .text-button's own pairing
   shows. */
.keyword-asked {
    color: var(--ui-shadow);
    text-shadow: none;
}

.bevel-raised {
    border-top-color: var(--ui-edge);
    border-right-color: var(--ui-edge);
    border-left-color: var(--ui-shadow);
    border-bottom-color: var(--ui-shadow);
    border-top-width: 6px;
    border-bottom-width: 6px;
    border-left-width: 5px;
    border-right-width: 5px;
}

.file-picker {
    position: absolute;
    flex-direction: row;
}

.file-picker-well {
    flex-grow: 1;
    overflow: hidden;
    background-color: var(--ui-surface);
}

.file-picker-rows {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
}

.file-picker-scrollbar {
    width: 80px;
    flex-shrink: 0;
    flex-direction: column;
    background-color: var(--ui-surface);
}

.file-picker-arrow {
    width: auto;
    height: auto;
    margin: 5px;
    align-items: center;
    justify-content: center;
    background-color: var(--ui-surface);
}

.file-picker-arrow-glyph {
    margin-top: 5px;
    margin-bottom: 5px;
}

.file-picker-arrow-glyph--flip {
    scale: 1 -1;
}

.file-picker-track {
    flex-grow: 1;
    border-color: var(--ui-shadow);
    border-width: 6px;
    margin: 5px;
}

.file-picker-thumb {
    position: absolute;
    height: 32px;
    width: 48px;
    background-color: var(--ui-surface);
}

.file-picker-row {
    height: 90px;
    padding-left: 10px;
    padding-right: 10px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    color: var(--ui-ink);
    background-color: var(--ui-surface);
    /* The text is a CHILD (GameFontText.Caption) for the same reason a button's is: this element
       carries the background and, when selected, the bevel, and scaling it to correct the glyph
       aspect would stretch both. Hence the flex centring here rather than -unity-text-align doing
       the work alone.

       The `font-size: 54px` that stood here is gone: Caption applies Canonical.GameFontSizePx (55),
       the size the advances were calibrated against. 54 was within 2% and looked deliberate. */
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}

.file-picker-row--selected {
    color: var(--ui-parchment);
    text-shadow: 0 6px 0 var(--ui-shadow);
}

/* IN_*.DAT text-entry boxes (InputFormRenderer): field bg14/border1, caret1, text0, selection10. */
.menu-input-field {
    background-color: var(--ui-surface);
    border-color: var(--ui-shadow);
}

.menu-input-text {
    color: var(--ui-ink);
}

.menu-input-caret {
    background-color: var(--ui-shadow);
}

.menu-input-selection {
    background-color: var(--ui-parchment);
}

/* An absolutely-placed REQ element positioned by data-driven left/top/width/height
   (the loader sets those inline). Added to the REQ text buttons, which share the
   flex-friendly .text-button chrome with DialogManager. */
.req-element {
    position: absolute;
}

.req-hitbox {
    position: absolute;
    background-color: rgba(0, 0, 0, 0);
}

/* LBL_*.DAT captions (MenuLabelRenderer). Same font and size as every other game-font surface —
   BakAgain.UI.GameFontText; the renderers set the size from the font data, 55px is the shipped
   GAME.FNT's value as a fallback. No stretch: the font is built at the original's pixel shape
   (TASK-765). */
.req-label {
    position: absolute;
    font-size: 55px;
    white-space: nowrap;
    -unity-text-align: upper-left;
    color: var(--ui-ink);
}

.req-label--centered {
    -unity-text-align: upper-center;
}

.req-label--title {
    color: var(--ui-parchment);
    text-shadow: 0 6px 0 var(--ui-shadow);
}

.req-hidden {
    visibility: hidden;
}

/* The stack-quantity picker's panel (REQ_INV2, drawQuantityPickerPanel @0x59D60): a brown
   surface inside a dark bevel, sitting over the inventory. Its buttons are plain
   .text-button + .req-element, so they read identically to every other REQ button. */
.qty-picker-panel {
    position: absolute;
    background-color: rgb(115, 78, 40);
    border-color: var(--ui-ink);
    border-top-width: 6px;
    border-bottom-width: 6px;
    border-left-width: 5px;
    border-right-width: 5px;
}

.qty-picker-title {
    position: absolute;
    -unity-text-align: upper-center;
    font-size: 55px;
    white-space: nowrap;
    color: var(--ui-parchment);
    text-shadow: 0 6px 0 var(--ui-shadow);
}

/* Colourset scope classes — applied alongside .classic-theme on a screen root to select
   the REQ pen palette (colourset id from the .DAT). .colorset-169 is the tan default
   already baked into the element classes above, so it needs no overrides. The others are
   placeholders until each screen is ported to its native colours. */
.colorset-169 {
}

.colorset-32 {
    /* TODO colour-match when ported; inherits menu for now */
}

.colorset-144 {
    /* TODO colour-match when ported; inherits menu for now */
}

.colorset-0 {
    /* TODO colour-match when ported; inherits menu for now */
}

/* Build version + log path on the Preferences screen (PreferencesMenu.OnAfterShow), for bug
   reports. Not in the original, so kept small and out of the way along the bottom edge. */
.build-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 44px;
    font-size: 33px;
    -unity-text-align: middle-center;
    color: var(--ui-ink);
}

/* Android touch aids (spec 2026-09-29-android-touch-aids-design.md): stone-coloured side-bar buttons. */
.touch-button {
    background-color: rgb(96, 70, 44);
    border-width: 3px;
    border-color: rgb(58, 40, 22);
    border-radius: 6px;
    justify-content: center;
    opacity: 0.9;
}
.touch-button > Label {
    -unity-text-align: middle-center;
    font-size: 40px;
    color: rgb(236, 210, 140);
}
.touch-button:active {
    background-color: rgb(140, 104, 62);
}
.touch-armed {
    background-color: rgb(172, 132, 70);
    border-color: rgb(236, 210, 140);
}

.enhanced-panel {
    background-color: rgb(150, 112, 62);
    border-width: 3px;
    border-color: rgb(58, 40, 22);
    padding: 2%;
    justify-content: space-around;
}

.enhanced-panel .text-button:disabled {
    opacity: 0.45;
}

/* The feature rows scroll between the master and Done (the panel fits eight rows). This theme does
   not import Unity's defaults, so the ScrollView's clipping is spelled out here; no scrollbar —
   the wheel and a drag scroll it, and the cut-off row below says there is more. */
.enhanced-panel #enhanced-feature-list,
.enhanced-panel #enhanced-feature-list #unity-content-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

/* Enhanced full-screen travel HUD (spec 2026-10-08 §3, EnhancedHudLayout). The REQ_MAIN elements
   are moved in here; the panel is 1200 units high at every aspect, so vertical percentages are of
   the window height. Two-class selectors so these beat .req-hitbox's absolute placement. Portrait
   widths are copied from their heights by EnhancedHudLayout (square boxes). */
.enhanced-hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.enhanced-hud .enhanced-hud__portraits { position: absolute; left: 1.5%; top: 3%; height: 48%; flex-direction: column; justify-content: space-between; }
/* The buttons keep their REQ size (the face is the icon at native size), so the column is scaled
   as a whole: 96% tall unscaled x 0.8 = 3%..79.8% of the window (owner, 2026-10-11: bigger than
   the mockup's 0.735). Lower than that meets the touch pads' forward arrow on a 16:9 screen. */
.enhanced-hud .enhanced-hud__buttons { position: absolute; right: 1.5%; top: 3%; height: 96%; flex-direction: column; justify-content: space-between; scale: 0.8 0.8; transform-origin: right top; }
.enhanced-hud .enhanced-hud__top { position: absolute; top: 2.5%; left: 0; right: 0; flex-direction: row; justify-content: center; align-items: center; }
.enhanced-hud .enhanced-hud__portrait { position: relative; height: 30.7%; }
.enhanced-hud .enhanced-hud__button { position: relative; }
.enhanced-hud .enhanced-hud__compass { position: relative; }
/* The spell plaque without its parchment, on the status line's dark bar (owner, 2026-10-12). */
.enhanced-hud .enhanced-hud__spellbar { position: relative; margin-right: 10px; border-radius: 3px; background-color: rgba(0, 0, 0, 0.6); flex-direction: row; justify-content: center; align-items: center; }
.enhanced-hud .enhanced-hud__spellrunes { position: relative; }
.enhanced-hud .enhanced-hud__status { margin-left: 10px; padding: 3px 9px; border-radius: 3px; background-color: rgba(0, 0, 0, 0.6); color: rgb(232, 216, 176); -unity-font-style: bold; white-space: nowrap; }
.enhanced-hud__ring { position: absolute; left: -6%; top: -6%; right: -6%; bottom: -6%; }
.enhanced-hud__dot { position: absolute; width: 18%; height: 18%; border-radius: 50%; border-width: 1px; border-color: rgb(0, 0, 0); }
.enhanced-hud__dot--Sick { background-color: rgb(220, 200, 50); }
.enhanced-hud__dot--Plagued { background-color: rgb(150, 60, 160); }
.enhanced-hud__dot--Poisoned { background-color: rgb(70, 190, 70); }
.enhanced-hud__dot--Drunk { background-color: rgb(200, 120, 40); }
.enhanced-hud__dot--Healing { background-color: rgb(90, 160, 230); }
.enhanced-hud__dot--Starving { background-color: rgb(150, 150, 150); }
.enhanced-hud__dot--NearDeath { background-color: rgb(200, 30, 30); }

/* Enhanced inventory (spec 2026-10-13, EnhancedInventoryLayout). The panel is 1200 units high at every
   aspect, so vertical px and percentages are of the window height. The REQ elements moved in here
   carry .req-hitbox, hence the two-class selectors. 55px is the game font's own size (.req-label). */
.enhanced-inv { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(43, 26, 14); background-repeat: repeat-x; background-size: auto 100%; }
.enhanced-inv .enhanced-inv__frame { position: absolute; left: 2.5%; top: 3%; right: 20%; bottom: 20.5%; padding: 10px; border-radius: 8px; border-width: 2px; border-color: rgb(122, 82, 40); background-color: rgb(74, 48, 24); }
.enhanced-inv .enhanced-inv__field { flex-grow: 1; overflow: visible; }
.enhanced-inv .enhanced-inv__sheet { position: absolute; left: 0; top: 0; width: 1600px; height: 1200px; transform-origin: 0 0; }
.enhanced-inv .enhanced-inv__portraits { position: absolute; right: 1.5%; top: 3%; bottom: 20.5%; width: 17%; flex-direction: column; justify-content: space-between; align-items: center; }
.enhanced-inv .enhanced-inv__portrait { align-items: center; }
.enhanced-inv .enhanced-inv__head { position: relative; width: 205px; height: 205px; }
.enhanced-inv .enhanced-inv__name { margin-top: 4px; font-size: 55px; white-space: nowrap; color: rgb(232, 216, 176); -unity-text-align: middle-center; }
.enhanced-inv .enhanced-inv__portrait--target .enhanced-inv__head { scale: 1.06 1.06; }
.enhanced-inv .enhanced-inv__portrait--target .enhanced-inv__name { color: rgb(255, 246, 220); }
.enhanced-inv .enhanced-inv__portrait--hover .enhanced-inv__head { scale: 1.12 1.12; }
.enhanced-inv .enhanced-inv__portrait--holder { opacity: 0.45; }
.enhanced-inv .enhanced-inv__shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.9); }
.enhanced-inv .enhanced-inv__head .enhanced-inv__shade { border-radius: 50%; }
.enhanced-inv .enhanced-inv__bar { position: absolute; left: 2.5%; right: 1.5%; bottom: 2.5%; height: 16%; flex-direction: row; align-items: center; padding: 0 18px; border-radius: 8px; border-width: 2px; border-color: rgb(122, 82, 40); background-color: rgba(42, 29, 18, 0.92); }
.enhanced-inv .enhanced-inv__window { position: relative; flex-shrink: 0; margin-right: 18px; }
.enhanced-inv .enhanced-inv__purse { position: relative; flex-shrink: 0; margin-right: 18px; justify-content: center; align-items: center; border-radius: 8px; background-color: rgb(0, 0, 0); }
.enhanced-inv .enhanced-inv__purse-text { font-size: 55px; white-space: nowrap; color: rgb(232, 216, 176); }
.enhanced-inv .enhanced-inv__hint { flex-grow: 1; flex-shrink: 1; overflow: hidden; font-size: 44px; white-space: normal; color: rgb(205, 185, 143); }
.enhanced-inv .enhanced-inv__button { position: relative; flex-shrink: 0; margin-left: 6px; }
.enhanced-inv .enhanced-inv__examine { position: absolute; left: 5%; right: 4%; top: 7%; bottom: 7%; flex-direction: row; }
.enhanced-inv .enhanced-inv__description { flex-grow: 1; flex-basis: 0; font-size: 44px; white-space: normal; color: var(--ui-ink); }
.enhanced-inv .enhanced-inv__stats { flex-grow: 1; flex-basis: 0; overflow: hidden; margin-left: 24px; padding-left: 24px; border-left-width: 2px; border-color: rgba(58, 36, 16, 0.4); }
.enhanced-inv .enhanced-inv__stat-lines { position: absolute; left: 24px; top: 0; transform-origin: 0 0; }
.enhanced-cast { position: absolute; left: 0; top: 0; right: 0; bottom: 0; flex-direction: row; padding: 28px; background-color: rgb(44, 36, 22); background-repeat: repeat; background-size: 720px 480px; }
.enhanced-cast .enhanced-cast__left { flex-shrink: 0; flex-direction: column; margin-right: 26px; width: 840px; }
.enhanced-cast .enhanced-cast__well { flex-grow: 1; overflow: hidden; border-radius: 4px; border-width: 4px; border-color: rgb(22, 16, 7); background-color: rgb(29, 23, 13); background-repeat: repeat; background-size: 720px 480px; }
.enhanced-cast .enhanced-cast__sheet { position: absolute; left: 0; top: 0; width: 1600px; height: 1200px; transform-origin: 0 0; }
.enhanced-cast .enhanced-cast__schools { height: 150px; flex-shrink: 0; margin-top: 22px; flex-direction: row; justify-content: space-around; align-items: center; border-radius: 4px; border-width: 3px; border-color: rgb(42, 29, 14); background-color: rgb(5, 4, 3); }
.enhanced-cast .enhanced-cast__school { position: relative; width: 118px; height: 118px; }
.enhanced-cast .enhanced-cast__exit { position: relative; width: 124px; height: 124px; flex-shrink: 0; margin-left: 18px; }
.enhanced-cast .enhanced-cast__stone { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 50%; background-size: 100% 100%; }
.enhanced-cast .enhanced-cast__school--off .enhanced-cast__stone { opacity: 0.35; }
.enhanced-cast .enhanced-cast__school--shown .enhanced-cast__stone { border-width: 4px; border-color: rgb(224, 149, 92); }
.enhanced-cast .enhanced-cast__exit-word { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-text-align: middle-center; font-size: 36px; color: rgb(28, 21, 11); }
.enhanced-cast .enhanced-cast__right { flex-grow: 1; flex-direction: column; }
.enhanced-cast .enhanced-cast__top { flex-grow: 1; flex-direction: row; }
.enhanced-cast .enhanced-cast__parch { flex-grow: 1; overflow: hidden; margin-right: 26px; border-radius: 3px; border-width: 5px; border-color: rgb(181, 112, 74); background-size: cover; }
.enhanced-cast .enhanced-cast__parch .cast-info-line { color: rgb(46, 29, 15); }
.enhanced-cast .enhanced-cast__portraits { width: 270px; flex-shrink: 0; flex-direction: column; justify-content: space-around; align-items: center; border-radius: 4px; border-width: 3px; border-color: rgb(42, 29, 14); background-color: rgb(5, 4, 3); }
.enhanced-cast .enhanced-cast__portrait { width: 214px; height: 214px; align-items: center; justify-content: center; background-size: 100% 100%; }
.enhanced-cast .enhanced-cast__head { position: relative; width: 160px; height: 160px; border-radius: 50%; overflow: hidden; }
.enhanced-cast .enhanced-cast__portrait--caster .enhanced-cast__head { border-width: 5px; border-color: rgb(156, 184, 220); }
.enhanced-cast .enhanced-cast__name { position: absolute; bottom: -30px; font-size: 40px; white-space: nowrap; color: rgb(191, 174, 140); -unity-text-align: middle-center; }
.enhanced-cast .enhanced-cast__portrait--caster .enhanced-cast__name { color: rgb(233, 183, 127); }
.enhanced-cast .enhanced-cast__bar { height: 150px; flex-shrink: 0; margin-top: 22px; flex-direction: row; align-items: center; padding: 0 22px; border-radius: 4px; border-width: 3px; border-color: rgb(42, 29, 14); background-color: rgb(5, 4, 3); }
.enhanced-cast .enhanced-cast__hint { flex-grow: 1; flex-shrink: 1; font-size: 40px; white-space: normal; color: rgb(205, 185, 143); }
.enhanced-cast .enhanced-cast__gem { background-size: 100% 100%; }
.enhanced-cast .enhanced-cast__holo { -unity-background-image-tint-color: rgba(255, 190, 170, 0.62); }
.enhanced-cast .enhanced-cast__holo.enhanced-cast__holo--dim { -unity-background-image-tint-color: rgba(255, 190, 170, 0.3); }
.enhanced-cast .enhanced-cast__holo.enhanced-cast__holo--lit { -unity-background-image-tint-color: rgb(255, 255, 255); scale: 1.15 1.15; }
.enhanced-cast .enhanced-cast__pool { -unity-background-image-tint-color: rgba(230, 70, 40, 0.35); }
.enhanced-cast .enhanced-cast__pool.enhanced-cast__holo--dim { -unity-background-image-tint-color: rgba(230, 70, 40, 0.14); }
.enhanced-cast .enhanced-cast__pool.enhanced-cast__holo--lit { -unity-background-image-tint-color: rgba(255, 120, 70, 0.8); scale: 1.35 1.35; }
.enhanced-cast .enhanced-cast__line-light { -unity-background-image-tint-color: rgba(220, 60, 36, 0.05); }
