<engine:UXML xmlns:engine="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
             editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/UnityThemes/Meta.uss?fileID=7433441132597879392&amp;guid=cd2c252b768de8d449963c41cade4c14&amp;type=3#Meta" />
    <engine:VisualElement name="VisualElement" style="flex-grow: 1; background-image: none; justify-content: center; align-items: center; border-top-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px; border-bottom-left-radius: 1px;">
        <engine:GroupBox name="GroupBox" class="textbox" style="width: 70%;">
            <engine:Label text="Label" selectable="true" focusable="true" style="white-space: pre-wrap; font-size: 24px;">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:713e69298cd02b14ebbc78bafce64b86" entry="Id(787981578616832)" />
                </Bindings>
            </engine:Label>
        </engine:GroupBox>
        <engine:GroupBox name="GroupBox" class="textbox" style="width: 70%; overflow: hidden; font-size: 24px;">
            <engine:Toggle name="ToggleEnableOverrides" enabled="true" data-source-type="ResourceManagement.BakResourceSettings, Assembly-CSharp">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="GUID:713e69298cd02b14ebbc78bafce64b86" entry="Id(74169233784832)" />
                </Bindings>
            </engine:Toggle>
            <engine:VisualElement class="text-field-container">
                <engine:TextField label="Text Field" name="TextFieldOverridePath" keyboard-type="Default" readonly="false">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:713e69298cd02b14ebbc78bafce64b86" entry="Id(74829748584448)" />
                    </Bindings>
                </engine:TextField>
                <engine:Button name="ButtonBrowseOverridePath" class="folder-button" style="background-image: url(&quot;project://database/Assets/Plugins/SimpleFileBrowser/Sprites/FileIcons/FolderIcon.png?fileID=2800000&amp;guid=27947666271b231439b4409a81cb5d59&amp;type=3#FolderIcon&quot;);" />
            </engine:VisualElement>
            <engine:VisualElement class="text-field-container" style="margin-top: 8px;">
                <engine:TextField readonly="true" name="TextFieldGameFilePath">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:713e69298cd02b14ebbc78bafce64b86" entry="Id(75443824050176)" />
                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:713e69298cd02b14ebbc78bafce64b86" entry="Id(74829748584448)" fallback="UseFallback" />
                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:713e69298cd02b14ebbc78bafce64b86" entry="Id(75443824050176)" />
                    </Bindings>
                </engine:TextField>
                <engine:Button name="ButtonBrowseGameFilePath" class="folder-button" style="background-image: url(&quot;project://database/Assets/Plugins/SimpleFileBrowser/Sprites/FileIcons/FolderIcon.png?fileID=2800000&amp;guid=27947666271b231439b4409a81cb5d59&amp;type=3#FolderIcon&quot;);" />
            </engine:VisualElement>
            <engine:Label name="LabelGamePathError" text="" style="white-space: pre-wrap; font-size: 18px; color: rgb(220, 90, 90); margin-top: 8px; margin-bottom: 8px;" />
            <engine:Button text="Continue" name="ButtonContinue" enabled="false" class="textbox" style="align-self: center; border-top-width: 4px; border-bottom-width: 4px; border-right-width: 4px; border-left-width: 4px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; font-size: 24px;">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:713e69298cd02b14ebbc78bafce64b86" entry="Id(127641824083968)" />
                </Bindings>
            </engine:Button>
        </engine:GroupBox>
    </engine:VisualElement>
</engine:UXML>
